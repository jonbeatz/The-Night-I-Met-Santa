{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tnims-type-inventory/v1",
  "title": "TNIMS / Hermes picture-book type inventory",
  "type": "object",
  "required": ["frames"],
  "properties": {
    "schema": { "const": "tnims-type-inventory/v1" },
    "unit": { "type": "string" },
    "source_psb": { "type": "string" },
    "canvas_px": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "dpi": { "type": "number" },
    "bleed_in": { "type": "number" },
    "exported_at": { "type": "string" },
    "notes": { "type": "string" },
    "frames": {
      "type": "array",
      "items": { "$ref": "#/definitions/frame" }
    }
  },
  "definitions": {
    "frame": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "unit": { "type": "string" },
        "group": { "type": "string" },
        "ps_layer": { "type": "string" },
        "page": { "enum": ["left", "right", "unknown"] },
        "book_page": { "type": "integer" },
        "bbox_px": {
          "type": "object",
          "properties": {
            "l": { "type": "number" },
            "t": { "type": "number" },
            "r": { "type": "number" },
            "b": { "type": "number" }
          }
        },
        "bounds_in": {
          "type": "object",
          "properties": {
            "top": { "type": "number" },
            "left": { "type": "number" },
            "bottom": { "type": "number" },
            "right": { "type": "number" }
          }
        },
        "font": { "type": "string" },
        "style": { "type": "string" },
        "size_pt": { "type": "number" },
        "leading_pt": { "type": ["number", "null"] },
        "tracking": { "type": ["number", "null"] },
        "color": { "type": "string" },
        "align": { "type": "string" },
        "paragraph_style": { "type": "string" },
        "text": { "type": "string" },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "integer" },
              "end": { "type": "integer" },
              "character_style": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
